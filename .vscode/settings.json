{
  "prettier.singleQuote": true,
  "svelte.enable-ts-plugin": true,
  "prettier.useTabs": false,
  "prettier.tabWidth": 2,
  "prettier.printWidth": 126,
  "prettier.arrowParens": "avoid",
  "prettier.trailingComma": "none",
  "prettier.objectWrap": "preserve",
  "prettier.bracketSameLine": true,
  "prettier.singleAttributePerLine": false,
  "prettier.experimentalTernaries": true,
  "prettier.experimentalOperatorPosition": "end",
  "prettier.svelteBracketNewLine": false,
  "prettier.svelteIndentScriptAndStyle": false,
  "js/ts.preferences.organizeImports": {
    "caseFirst": "lower",
    "typeOrder": "last"
  },
  "files.exclude": {
    "**/.git": false
  }
}
