{
  "name": "fantaseer",
  "version": "0.0.2",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "vite build",
    "build:ext": "node .scripts/build-ext.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "ext:zip": "cd .build/extension && zip -r ../extension.zip . -x '.*'",
    "ext:build": "npm run build:ext && npm run ext:zip",
    "db:start": "docker compose up",
    "db:push": "drizzle-kit push",
    "db:export": "drizzle-kit export --config=drizzle.local.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.local.ts",
    "db:generate:seed": "drizzle-kit generate --config=drizzle.local.ts --custom --name=seed",
    "db:migrate": "drizzle-kit migrate --config=drizzle.local.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.local.ts",
    "db": "sst shell drizzle-kit",
    "db:sst:push": "sst shell drizzle-kit push",
    "db:sst:generate": "sst shell drizzle-kit generate",
    "db:sst:migrate": "sst shell drizzle-kit migrate",
    "db:sst:studio": "sst shell drizzle-kit studio",
    "db:pull": "sst shell drizzle-kit pull",
    "dev": "node --inspect=9229 node_modules/.bin/vite dev",
    "dev:bang": "VITE_TARGET=mock vite dev",
    "dev:pre": "SST_DEBUG=true npx sst deploy --stage pre",
    "prepare": "svelte-kit sync || echo ''",
    "preview": "vite preview",
    "test:seed": "SKIP_SETUP=1 vitest run tests/seed/all",
    "db:populate": "vitest run tests/live/populate",
    "db:populate:dry": "SEED_DRY=1 vitest run tests/live/populate",
    "db:populate:purge": "SEED_PURGE=only vitest run tests/live/populate",
    "db:populate:local": "SEED_LOCAL=1 SEED_PURGE=1 vitest run tests/live/populate",
    "db:populate:local:dry": "SEED_LOCAL=1 SEED_DRY=1 vitest run tests/live/populate",
    "db:populate:local:purge": "SEED_LOCAL=1 SEED_PURGE=only vitest run tests/live/populate"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.21.0",
    "daisyui": "^5.7.16",
    "drizzle-kit": "^1.0.0-beta.21",
    "glob": "^13.0.5",
    "postgres": "^3.4.9",
    "sst-linux-x64": "^4.7.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "drizzle-orm": "^1.0.0-beta.21",
    "pg": "^8.23.0",
    "sst": "4.17.1",
    "svelte-kit-sst": "2.43.5"
  }
}
